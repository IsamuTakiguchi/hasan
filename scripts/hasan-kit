#!/usr/bin/env bash
# hasan プラグインのコマンドディスパッチャ。
# プラグインの bin/ は Claude Code により PATH に追加されるため、スキルは
# インストール場所を知らなくても `hasan-kit <subcommand>` で各スクリプトを呼べる。
set -euo pipefail

ROOT="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
PY=python3

# 依存ブートストラップ: 不足している pip パッケージだけを初回に自動導入する
# （Cowork 等のクリーンな実行環境向け。HASAN_KIT_NO_BOOTSTRAP=1 でスキップ）
ensure_deps() {
  [ "${HASAN_KIT_NO_BOOTSTRAP:-}" = "1" ] && return 0
  "$PY" -c "import lxml, openpyxl, yaml, jsonschema, docx" 2>/dev/null && return 0
  echo "hasan-kit: 依存パッケージを導入します（初回のみ）..." >&2
  "$PY" -m pip install --user --quiet lxml openpyxl PyYAML jsonschema PyMuPDF python-docx 2>&1 | tail -1 >&2 || \
    "$PY" -m pip install --quiet lxml openpyxl PyYAML jsonschema PyMuPDF python-docx 2>&1 | tail -1 >&2 || {
      echo "hasan-kit: pip での依存導入に失敗。'hasan-kit doctor' で環境を確認してください" >&2
      return 1
    }
}

doctor() {
  echo "hasan-kit doctor — 環境診断"
  echo "  プラグインルート : $ROOT"
  echo "  python3          : $(command -v "$PY" || echo '✗ 見つからない')"
  "$PY" --version 2>/dev/null | sed 's/^/  /'
  echo "  pip              : $("$PY" -m pip --version 2>/dev/null | cut -d' ' -f1-2 || echo '✗ 見つからない')"
  for m in lxml openpyxl yaml jsonschema pymupdf docx; do
    if "$PY" -c "import $m" 2>/dev/null; then echo "  $m : OK"; else echo "  $m : ✗ 未導入（初回実行時に自動導入）"; fi
  done
  for c in soffice unoconvert; do
    if command -v "$c" >/dev/null 2>&1; then echo "  $c : OK ($(command -v $c))"; else echo "  $c : ✗ なし"; fi
  done
  if ! command -v soffice >/dev/null 2>&1 && ! command -v unoconvert >/dev/null 2>&1; then
    echo "  注意: PDF目視検証（preview）は省略運転になります（数値整合検査 crosscheck は動作）"
  fi
}

workdir_zip() {
  # Cowork「フォルダを接続」用の作業フォルダ一式（プラグインのスキルマウント不具合の回避策）。
  # 構成: hasan-work/ ├ CLAUDE.md（スキルへの誘導） ├ cases/ └ hasan/（プラグイン一式）
  local version
  version=$("$PY" -c "import json; print(json.load(open('$ROOT/.claude-plugin/plugin.json'))['version'])")
  local out="${1:-$PWD/hasan-work-v${version}.zip}"
  local tmp
  tmp=$(mktemp -d)
  mkdir -p "$tmp/hasan-work/cases" "$tmp/hasan-work/hasan"
  cp "$ROOT/templates/workdir-CLAUDE.md" "$tmp/hasan-work/CLAUDE.md"
  cat > "$tmp/hasan-work/cases/README.md" <<'EOM'
事件フォルダの置き場所。cases/<事件ID>/input/ に原資料（調査票・通帳PDF・面談メモ等）を
置いて「資料を読み込んで」と依頼する。依頼者情報を含むため git 管理・共有はしないこと。
EOM
  printf '*\n!README.md\n!.gitignore\n' > "$tmp/hasan-work/cases/.gitignore"
  ( cd "$ROOT" && tar cf - --exclude=.git --exclude=cases --exclude='__pycache__' \
      --exclude='*.pyc' --exclude=.claude . ) | ( cd "$tmp/hasan-work/hasan" && tar xf - )
  rm -f "$out"  # zip -r は既存アーカイブへ追記するため必ず作り直す
  ( cd "$tmp" && zip -qr "$out" hasan-work )
  rm -rf "$tmp"
  echo "作業フォルダ一式: $out"
  echo "使い方: 解凍してできる hasan-work フォルダを Cowork の「フォルダを接続」で渡す"
}

case_zip() {
  # 事件ごとの個別フォルダを Cowork「フォルダを接続」で使うためのテンプレ一式。
  # 解凍すると「100.破産申立」フォルダができる。事件ごとにコピーして使う。
  # 構成: 100.破産申立/ ├ CLAUDE.md（スキル誘導・パス読み替え表）
  #       ├ 受領資料|作業ファイル|申立書類/ └ システム/（エンジン・書式一式）
  local version
  version=$("$PY" -c "import json; print(json.load(open('$ROOT/.claude-plugin/plugin.json'))['version'])")
  local out="${1:-$PWD/hasan-case-v${version}.zip}"
  local tmp
  tmp=$(mktemp -d)
  local dirname="100.破産申立"
  mkdir -p "$tmp/$dirname/受領資料" "$tmp/$dirname/作業ファイル" "$tmp/$dirname/申立書類" "$tmp/$dirname/システム"
  cp "$ROOT/templates/casedir-CLAUDE.md" "$tmp/$dirname/CLAUDE.md"
  cat > "$tmp/$dirname/受領資料/README.md" <<'EOM'
原資料の置き場所（調査票・通帳PDF・面談メモ・債権調査票等）。ここに置いて
「資料を読み込んで」と依頼すると case.yaml が作られる。
EOM
  cat > "$tmp/$dirname/作業ファイル/README.md" <<'EOM'
Claude が使う中間ファイルの置き場所（聴取シート・面談メモの docx、通帳CSV、
生成用の values ファイル、処理済み状態の記録 state.json 等）。
聴取シートはここに作られる。state.json は削除しないこと（差分検知の基準）。
EOM
  cat > "$tmp/$dirname/申立書類/README.md" <<'EOM'
生成された裁判所提出書類（Word/Excel）と検証用PDF・画像の置き場所。
手で修正した場合は、次回の更新時に Claude が上書き前に確認する。
EOM
  ( cd "$ROOT" && tar cf - --exclude=.git --exclude=cases --exclude='__pycache__' \
      --exclude='*.pyc' --exclude=.claude . ) | ( cd "$tmp/$dirname/システム" && tar xf - )
  rm -f "$out"  # 既存アーカイブへの追記を防ぐため必ず作り直す
  # 日本語フォルダ名の文字化け対策: Windows の標準解凍は CP932、Mac は UTF-8 を想定する。
  # --win 指定時はファイル名を CP932 で格納した zip を作る（既定は UTF-8）。
  "$PY" - "$tmp" "$dirname" "$out" "${2:-utf-8}" <<'PYZIP'
import os, sys, zipfile
src_root, top, out, enc = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
codec = "cp932" if enc == "--win" else "utf-8"
if codec == "cp932":
    # zipfile は非ASCII名を常に UTF-8+フラグで書くため、CP932 で書く場合は
    # 内部エンコーダを差し替える（Windows 標準解凍が ANSI(CP932) で読む前提）
    zipfile.ZipInfo._encodeFilenameFlags = lambda self: (self.filename.encode("cp932"), 0)
with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    base = os.path.join(src_root, top)
    for root, dirs, files in os.walk(base):
        dirs.sort()
        rel = os.path.relpath(root, src_root)
        if not files and not dirs:
            z.writestr(rel.replace(os.sep, "/") + "/", b"")
        for f in sorted(files):
            full = os.path.join(root, f)
            z.write(full, os.path.join(rel, f).replace(os.sep, "/"))
PYZIP
  rm -rf "$tmp"
  echo "事件フォルダテンプレ: $out（ファイル名エンコーディング: ${2:---utf-8 既定}）"
  echo "使い方: 解凍 →「100.破産申立」フォルダを事件ごとにコピー → Cowork の「フォルダを接続」で渡す"
  echo "※ Windows で解凍して文字化けする場合は case-zip <出力zip> --win で作り直す"
}

package() {
  local version
  version=$("$PY" -c "import json; print(json.load(open('$ROOT/.claude-plugin/plugin.json'))['version'])")
  local out="${1:-$PWD/hasan-plugin-v${version}.zip}"
  rm -f "$out"  # zip -r は既存アーカイブへ追記するため必ず作り直す
  ( cd "$ROOT" && zip -qr "$out" . \
      -x ".git/*" -x "cases/*" -x "*__pycache__*" -x "*.pyc" -x ".claude/*" )
  echo "配布用パッケージ: $out"
  echo "Cowork へは: Cowork タブ → Customize → Install → このzipをアップロード"
}

usage() {
  cat <<'EOF'
使い方: hasan-kit <subcommand> [args...]

  root                          プラグインルートのパスを表示
  courts                        courts/（書式ディレクトリ）のパスを表示
  schema                        schema/ のパスを表示
  doctor                        環境診断（Python/pip/依存/LibreOffice の有無）
  package [出力zip]             Cowork等へ配布するプラグインzipを生成
  workdir-zip [出力zip]         Cowork「フォルダを接続」用の作業フォルダ一式を生成
                                （全事件を1フォルダで管理する方式）
  case-zip [出力zip]            事件ごとの個別フォルダ用テンプレ一式を生成
                                （事件フォルダを直接「フォルダを接続」する方式）
  scan --dir <事件フォルダ> [--write]
                                前回処理後の差分検知（update スキルの入口。--write で状態保存）
  validate-case <case.yaml>     事件モデルの検証（生成前ゲート）
  fill-docx --template .. --fillmap .. --values .. --output ..
                                docx書式のfillmap駆動記入
  memo-docx --spec .. --output ..  聴取シート・面談メモ等の事務所内docx生成
  saikensha --case .. --output .. [--kouso|--generic]
                                債権者一覧表（--kouso で公租公課用）
  shisan    --case .. --output .. [--generic]   財産目録
  kakei     --case .. --output .. [--generic]   家計収支表
  kanzai-xlsx --doc <書式> --case .. --output ..
                                管財xlsx（shisan-fusai/saikensha-kanzai/hikazei-check/
                                shisan-kanzai/lease/sosho-shobun）
  bank-analyze --csv .. --case .. [-o ..]       通帳明細の異常検知
  inspect-docx <docx> [-o ..] [--full]          docxアンカーダンプ（書式登録用）
  inspect-xlsx <xlsx> [-o ..]                   xlsxセルマップダンプ（書式登録用）
  check-anchors <fillmap> <template>            fillmapアンカー検査
  diff-fillmap --old-fillmap .. --new-template .. [--write ..] [--report ..]
                                書式改訂の照合・自動再束縛
  preview <files...> [-d dir]                   PDF・ページ画像化（目視検証）
  crosscheck --case .. --dir ..                 書類間の数値整合検査
EOF
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true
case "$cmd" in
  root|courts|schema|doctor|package|""|-h|--help|help) : ;;  # 依存不要のコマンド
  *) ensure_deps ;;
esac
case "$cmd" in
  root)          echo "$ROOT" ;;
  courts)        echo "$ROOT/courts" ;;
  schema)        echo "$ROOT/schema" ;;
  doctor)        doctor ;;
  package)       package "$@" ;;
  workdir-zip)   workdir_zip "$@" ;;
  case-zip)      case_zip "$@" ;;
  scan)          exec "$PY" "$ROOT/scripts/casekit/scan_changes.py" "$@" ;;
  validate-case) exec "$PY" "$ROOT/scripts/casekit/validate_case.py" "$@" ;;
  fill-docx)     exec "$PY" "$ROOT/scripts/build/fill_docx.py" "$@" ;;
  memo-docx)     exec "$PY" "$ROOT/scripts/build/build_memo_docx.py" "$@" ;;
  saikensha)     exec "$PY" "$ROOT/scripts/build/build_saikensha_ichiran.py" "$@" ;;
  shisan)        exec "$PY" "$ROOT/scripts/build/build_shisan_mokuroku.py" "$@" ;;
  kakei)         exec "$PY" "$ROOT/scripts/build/build_kakei_shushi.py" "$@" ;;
  kanzai-xlsx)   exec "$PY" "$ROOT/scripts/build/build_kanzai_xlsx.py" "$@" ;;
  bank-analyze)  exec "$PY" "$ROOT/scripts/casekit/bank_analyze.py" "$@" ;;
  inspect-docx)  exec "$PY" "$ROOT/scripts/formkit/inspect_docx.py" "$@" ;;
  inspect-xlsx)  exec "$PY" "$ROOT/scripts/formkit/inspect_xlsx.py" "$@" ;;
  check-anchors) exec "$PY" "$ROOT/scripts/formkit/check_anchors.py" "$@" ;;
  diff-fillmap)  exec "$PY" "$ROOT/scripts/formkit/diff_fillmap.py" "$@" ;;
  preview)       exec "$PY" "$ROOT/scripts/verify/render_preview.py" "$@" ;;
  crosscheck)    exec "$PY" "$ROOT/scripts/verify/crosscheck_outputs.py" "$@" ;;
  ""|-h|--help|help) usage ;;
  *) echo "hasan-kit: 未知のサブコマンド '$cmd'" >&2; usage >&2; exit 64 ;;
esac
